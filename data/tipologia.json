    {
      "id": "region",
      "tier": 1,
      "nombre": "Región",
      "descripcion": "Gran región de referencia por nombre (Peloponeso, Eubea, Tracia); también mares y golfos."
    },
    {
      "id": "archipielago",
      "tier": 2,
      "nombre": "Conjunto de islas",
      "descripcion": "Islas cuya importancia es su conexión entre sí (Cícladas, Espóradas del Norte)."
    },
    {
      "id": "ethnos",
      "tier": 2,
      "nombre": "Ethnos",
      "descripcion": "Región de un pueblo sin centro dominante; liga o koinon (Arcadia, Acaya)."
    },
    {
      "id": "chora",
      "tier": 3,
      "nombre": "Eupolis",
      "descripcion": "Unidad política con su territorio, aunque abarque varias islas (Delos con Mykonos; Korinthia, Karystia). También ríos, cordilleras y llanuras de ese tamaño."
    },
    {
      "id": "nesos",
      "tier": 4,
      "nombre": "Nesos (isla)",
      "descripcion": "La isla como unidad física dentro de una eupolis (Delos, Mykonos)."
    },
    {
      "id": "polis-kome",
      "tier": 4,
      "nombre": "Asentamiento (polis / kome)",
      "descripcion": "El asentamiento en sí, de la aldea a la ciudad (Corinto, Olinto, Tenea); su forma se describe por periodos. También islotes, cabos, lagos y montes locales."
    },
    {
      "id": "demos",
      "tier": 5,
      "nombre": "Sub-asentamiento: barrio / demos",
      "descripcion": "Barrio, distrito o núcleo urbano dentro de un asentamiento o de una isla (Kerameikos; la ciudad de Delos); la acrópolis como unidad."
    },
    {
      "id": "moira",
      "tier": 5,
      "nombre": "Sub-asentamiento: recinto / paraje",
      "descripcion": "Recinto, sector o paraje: ágora, témenos, santuario, murallas, necrópolis, bosque, finca; cuevas y cumbres."
    },
    {
      "id": "oikema",
      "tier": 6,
      "nombre": "Oikema",
      "descripcion": "Construcción individual: naos, stoa, altar, fuente, tumba, puerta, casa."
    }
